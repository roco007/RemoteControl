<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/gesture_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/gesture_widget_background"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="6dp"
  android:paddingBottom="6dp">
  <LinearLayout
    android:id="@+id/gesture_widget_normal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
      android:id="@+id/gesture_widget_icon"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:layout_marginEnd="10dp"
      android:src="@drawable/ic_gesture_widget_off"
      android:importantForAccessibility="no" />
    <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gesture_widget_title"
        android:textColor="#F2F8F5"
        android:textStyle="bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:maxLines="1" />
      <TextView
        android:id="@+id/gesture_widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gesture_widget_off"
        android:textColor="#B5C7BE"
        android:textStyle="bold"
        android:textSize="12sp"
        android:includeFontPadding="false"
        android:maxLines="1" />
      <TextView
        android:id="@+id/gesture_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gesture_widget_tap_on"
        android:textColor="#A7BBB1"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />
    </LinearLayout>
  </LinearLayout>
  <TextView
    android:id="@+id/gesture_widget_active"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:textColor="#C4F58A"
    android:textStyle="bold"
    android:textSize="24sp"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="14sp"
    android:autoSizeMaxTextSize="30sp"
    android:autoSizeStepGranularity="1sp"
    android:includeFontPadding="false"
    android:maxLines="2"
    android:visibility="gone" />
</FrameLayout>
